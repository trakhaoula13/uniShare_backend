# ============================================================
# backend/.env.example  (CE FICHIER PEUT ETRE ENVOYE SUR GITHUB)
# Copie-le en ".env" pour travailler en local, puis remplis les valeurs.
# Le vrai fichier ".env" ne doit JAMAIS etre envoye sur GitHub.
# ============================================================

# --- Variables existantes de ton backend (garde tes propres noms) ---
# PORT=5000
# MONGO_URI=...
# JWT_SECRET=...
# JWT_EXPIRES_IN=7d

# --- Stockage des fichiers : Backblaze B2 (compatible S3) ---
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_BUCKET=unishare-files-2026
S3_ACCESS_KEY_ID=19d41d98f70e
S3_SECRET_ACCESS_KEY=Master Application Key

# (optionnel) adresse publique du backend, utilisee dans les liens des fichiers
# PUBLIC_BACKEND_URL=https://unishare-backend-83eh.onrender.com
